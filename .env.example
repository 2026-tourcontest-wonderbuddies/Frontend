# 이 파일을 .env.local로 복사해서 쓰세요.
# 백엔드 API의 베이스 URL. 반드시 /api 까지 포함합니다.
#   배포 서버: https://tourcontest-backend.onrender.com/api
#   로컬 Django: http://127.0.0.1:8000/api
VITE_API_BASE_URL=https://tourcontest-backend.onrender.com/api

# 구글 로그인 클라이언트 ID (Google Cloud Console > OAuth 2.0 클라이언트 ID)
VITE_GOOGLE_CLIENT_ID=

# 카카오맵 JavaScript 키. 비워두면 지도가 기존 미리보기(격자 + 핀)로 대체됩니다.
# 발급: https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# 발급 후 [앱 설정 > 플랫폼 > Web]에 사용할 도메인을 반드시 등록하세요.
#   개발: http://localhost:5173
VITE_KAKAO_MAP_KEY=

# 실제 백엔드가 준비되면 이 값을 채우고 .env.local로 복사하세요.
# 비워두면 기본값 "/api"를 쓰고, MSW가 그 경로를 가로채 목업 응답을 돌려줍니다.
VITE_API_BASE_URL=

# "false"로 두면 MSW 목업을 끄고 VITE_API_BASE_URL의 실제 서버를 호출합니다.
VITE_USE_MOCKS=true

# 카카오맵 JavaScript 키. 비워두면 지도가 기존 미리보기(격자 + 핀)로 대체됩니다.
# 발급: https://developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
# 발급 후 [앱 설정 > 플랫폼 > Web]에 사용할 도메인을 반드시 등록하세요.
#   개발: http://localhost:5173
VITE_KAKAO_MAP_KEY=
